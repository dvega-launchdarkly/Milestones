// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Parent/Guardian User (auth handled by Clerk)
model Parent {
  id             String   @id @default(cuid())
  clerkId        String   @unique // Clerk user ID
  email          String   @unique
  name           String
  // Which household this user is currently looking at, for people who belong
  // to more than one (e.g. a grandparent with their own family)
  activeFamilyId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  children     ChildProfile[]
  memberships  FamilyMembership[]
  sentInvites  FamilyInvite[]     @relation("SentInvites")
  activeFamily Family?            @relation("ActiveFamily", fields: [activeFamilyId], references: [id], onDelete: SetNull)

  @@map("parents")
}

// Household - owns the children. Adults join it through FamilyMembership.
model Family {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  children    ChildProfile[]
  memberships FamilyMembership[]
  invites     FamilyInvite[]
  activeFor   Parent[]           @relation("ActiveFamily")

  @@map("families")
}

// A pending invitation to join a household. Only the SHA-256 hash of the token
// is stored - the raw value lives in the invite link and nowhere else.
model FamilyInvite {
  id           String    @id @default(cuid())
  familyId     String
  email        String
  role         String    @default("viewer")
  relationship String?
  tokenHash    String    @unique
  status       String    @default("pending") // "pending", "accepted", "revoked"
  invitedById  String?
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy Parent? @relation("SentInvites", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([status])
  @@map("family_invites")
}

// An adult's place in a household: what they may do (role) and who they are to
// the children (relationship, see lib/family-roles.ts)
model FamilyMembership {
  id           String   @id @default(cuid())
  familyId     String
  parentId     String
  role         String   @default("viewer") // "owner", "editor", "viewer"
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([familyId, parentId])
  @@index([parentId])
  @@map("family_memberships")
}

// Child Profile
model ChildProfile {
  id        String   @id @default(cuid())
  familyId  String
  // Kept alongside familyId so a rollback to pre-household code still works.
  // Dropped in a later migration once the household rollout has settled.
  parentId  String
  firstName String
  lastName  String
  icon      String   @default("baby")
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent       Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([familyId])
  @@index([parentId])
  @@map("child_profiles")
}

// Spotify Song (cached from Spotify API)
model Song {
  id           String   @id @default(cuid())
  spotifyId    String   @unique // Spotify track ID
  title        String
  artist       String
  album        String
  albumArtUrl  String?
  duration     Int      // Duration in milliseconds
  previewUrl   String?
  spotifyUrl   String
  genres       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  interactions Interaction[]

  @@index([spotifyId])
  @@map("songs")
}

// Interaction - tracks what media a child was exposed to and their reaction
model Interaction {
  id        String   @id @default(cuid())
  childId   String
  songId    String
  rating    String   @default("neutral") // "thumbs_up", "thumbs_down", "neutral"
  review    String?  // Optional text review/notes
  exposedAt DateTime @default(now()) // When the child was exposed to this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  song  Song         @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([songId])
  @@index([exposedAt])
  @@map("interactions")
}
